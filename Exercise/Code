import pandas as pd
from sklearn.datasets import load_iris
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LogisticRegression
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import accuracy_score
import seaborn as sns
import matplotlib.pyplot as plt
data = load_iris()
X = pd.DataFrame(data.data, columns=data.feature_names)
y = data.target
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2)
log = LogisticRegression(max_iter=200)
log.fit(X_train, y_train)
y_pred1 = log.predict(X_test)
rf = RandomForestClassifier()
rf.fit(X_train, y_train)
y_pred2 = rf.predict(X_test)
print("Accuracy Logistic:", accuracy_score(y_test, y_pred1))
print("Accuracy RandomForest:", accuracy_score(y_test, y_pred2))
plt.subplot(1,2,1)
sns.heatmap(pd.crosstab(y_test, y_pred1), annot=True, cmap='Blues')
plt.title("Logistic Regression")
plt.subplot(1,2,2)
sns.heatmap(pd.crosstab(y_test, y_pred2), annot=True, cmap='Greens')
plt.title("Random Forest")
plt.show()
